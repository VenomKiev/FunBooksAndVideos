{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Properties": {
      "Application": "FunBooksAndVideos.API"
    }
  },
  "Persistence": {
    "DatabaseName": "FunBooksAndVideos"
  },
  "AllowedHosts": "*"
}
